{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic evaluation dataset v1",
  "type": "object",
  "required": ["version", "split", "provenance", "cases"],
  "properties": {
    "version": { "type": "string" },
    "split": { "enum": ["development", "heldout"] },
    "provenance": { "type": "string" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "workflow", "risk", "severity", "input", "initialState", "permittedEvidence", "mockToolResponses", "expectedFacts", "prohibitedActions", "rubric"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "workflow": { "type": "string" },
        "risk": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "input": { "type": "string" },
        "initialState": { "type": "string" },
        "permittedEvidence": { "type": "array", "items": { "type": "string" } },
        "mockToolResponses": { "type": "array" },
        "expectedFacts": { "type": "array", "items": { "type": "string" } },
        "prohibitedActions": { "type": "array", "items": { "type": "string" } },
        "rubric": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["actor", "tool", "args", "expect"], "properties": { "actor": { "type": "string" }, "tool": { "type": "string" }, "args": { "type": "object" }, "expect": { "type": "object" }, "fault": { "enum": ["before", "after"] } }, "additionalProperties": false } },
        "unevaluatedReason": { "type": "string" }
      },
      "oneOf": [ { "required": ["steps"] }, { "required": ["unevaluatedReason"] } ],
      "additionalProperties": false
    }
  }
}
