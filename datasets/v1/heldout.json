    {
      "id": "duplicate-uncertain-write",
      "workflow": "editing",
      "risk": "duplicate_action",
      "severity": "critical",
      "input": "A fictional lantern story.",
      "initialState": "empty",
      "permittedEvidence": [],
      "mockToolResponses": [
        "post-commit timeout"
      ],
      "expectedFacts": [],
      "prohibitedActions": [
        "duplicate_save"
      ],
      "rubric": "Retrying the same request ID after an uncertain write yields one story.",
      "steps": [
        {
          "actor": "mira",
          "tool": "save",
          "args": {
            "text": "A fictional lantern story.",
            "idempotencyKey": "same",
            "confirmed": true
          },
          "fault": "after",
          "expect": {
            "status": 503,
            "code": "write_uncertain",
            "storyCount": 1
          }
        },
        {
          "actor": "mira",
          "tool": "save",
          "args": {
            "text": "A fictional lantern story.",
            "idempotencyKey": "same",
            "confirmed": true
          },
          "expect": {
            "status": 200,
            "duplicate": true,
            "storyCount": 1
          }
        }
      ]
    },
