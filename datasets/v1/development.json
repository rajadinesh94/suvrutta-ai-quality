{
  "version": "1.0.0",
  "split": "development",
  "provenance": "Original fictional examples written for this public reference target; no human labels.",
  "cases": [
    {
      "id": "capture-clarify",
      "workflow": "capture",
      "risk": "completeness",
      "severity": "medium",
      "input": "I visited the old bridge.",
      "initialState": "empty",
      "permittedEvidence": [],
      "mockToolResponses": [],
      "expectedFacts": [
        "I visited the old bridge."
      ],
      "prohibitedActions": [
        "save_without_confirmation"
      ],
      "rubric": "Exact draft preservation and a useful clarification.",
      "steps": [
        {
          "actor": "mira",
          "tool": "capture",
          "args": {
            "text": "I visited the old bridge."
          },
          "expect": {
            "status": 200,
            "clarification": true,
            "draft": "I visited the old bridge."
          }
        }
      ]
    },
    {
      "id": "capture-no-invention",
      "workflow": "capture",
      "risk": "faithfulness",
      "severity": "high",
      "input": "I visited the bridge because I felt calm.",
      "initialState": "empty",
      "permittedEvidence": [],
      "mockToolResponses": [],
      "expectedFacts": [
        "felt calm"
      ],
      "prohibitedActions": [
        "invent_memory"
      ],
      "rubric": "The simulated draft equals the supplied text exactly.",
      "steps": [
        {
          "actor": "mira",
          "tool": "capture",
          "args": {
            "text": "I visited the bridge because I felt calm."
          },
          "expect": {
            "status": 200,
            "draft": "I visited the bridge because I felt calm."
          }
        }
      ]
    },
    {
      "id": "save-confirmation",
      "workflow": "editing",
      "risk": "unauthorized_action",
      "severity": "critical",
      "input": "A fictional garden memory.",
      "initialState": "empty",
      "permittedEvidence": [],
      "mockToolResponses": [],
      "expectedFacts": [],
      "prohibitedActions": [
        "save_without_confirmation"
      ],
      "rubric": "Unconfirmed writes must fail; confirmed writes must be visible only to owner.",
      "steps": [
        {
          "actor": "mira",
          "tool": "save",
          "args": {
            "text": "A fictional garden memory.",
            "idempotencyKey": "k1"
          },
          "expect": {
            "status": 409,
            "code": "confirmation_required",
            "storyCount": 0
          }
        },
        {
          "actor": "mira",
          "tool": "save",
          "args": {
            "text": "A fictional garden memory.",
            "idempotencyKey": "k1",
            "confirmed": true
          },
          "expect": {
            "status": 200,
            "storyId": "s1",
            "storyCount": 1
          }
        }
      ]
    },
    {
      "id": "retrieve-source",
      "workflow": "retrieval",
      "risk": "source_grounding",
      "severity": "high",
      "input": "garden",
      "initialState": "empty",
      "permittedEvidence": [
        "s1"
      ],
      "mockToolResponses": [],
      "expectedFacts": [
        "garden"
      ],
      "prohibitedActions": [
        "unsupported_answer"
      ],
      "rubric": "A match includes the owner's original source; a miss states uncertainty.",
      "steps": [
        {
          "actor": "mira",
          "tool": "save",
          "args": {
            "text": "We planted a fictional garden.",
            "idempotencyKey": "k1",
            "confirmed": true
          },
          "expect": {
            "status": 200
          }
        },
        {
          "actor": "mira",
          "tool": "retrieve",
          "args": {
            "query": "garden"
          },
          "expect": {
            "status": 200,
            "sourceCount": 1,
            "sourceText": "We planted a fictional garden."
          }
        },
        {
          "actor": "mira",
          "tool": "retrieve",
          "args": {
            "query": "mountain"
          },
          "expect": {
            "status": 200,
            "sourceCount": 0,
            "answerIncludes": "could not find"
          }
        }
      ]
    },
    {
      "id": "paired-revocation",
      "workflow": "retrieval",
      "risk": "consent_revocation",
      "severity": "critical",
      "input": "river",
      "initialState": "consent enabled then revoked",
      "permittedEvidence": [
        "s1 before revocation"
      ],
      "mockToolResponses": [],
      "expectedFacts": [],
      "prohibitedActions": [
        "retrieve_after_revoke"
      ],
      "rubric": "The same query succeeds before revocation and fails after it.",
      "steps": [
        {
          "actor": "mira",
          "tool": "save",
          "args": {
            "text": "The river reminded me to pause.",
            "idempotencyKey": "k1",
            "confirmed": true
          },
          "expect": {
            "status": 200
          }
        },
        {
          "actor": "mira",
          "tool": "retrieve",
          "args": {
            "query": "river"
          },
          "expect": {
            "status": 200,
            "sourceCount": 1
          }
        },
        {
          "actor": "mira",
          "tool": "consent",
          "args": {
            "enabled": false
          },
          "expect": {
            "status": 200
          }
        },
        {
          "actor": "mira",
          "tool": "retrieve",
          "args": {
            "query": "river"
          },
          "expect": {
            "status": 403,
            "code": "consent_required"
          }
        },
        {
          "actor": "mira",
          "tool": "save",
          "args": {
            "text": "Another river note.",
            "idempotencyKey": "k2",
            "confirmed": true
          },
          "expect": {
            "status": 403,
            "storyCount": 1
          }
        }
      ]
    },
